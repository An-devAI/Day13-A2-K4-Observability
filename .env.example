APP_ENV=dev
APP_NAME=day13-observability-lab
LOG_LEVEL=INFO
LOG_PATH=data/logs.jsonl
AUDIT_LOG_PATH=data/audit.jsonl
# Trần output token cho mỗi câu trả lời (tương đương max_tokens của LLM thật).
# Bỏ trống hoặc <= 0 = không chặn. Output đắt gấp 5 lần input nên đây là cần
# gạt chi phí hiệu quả nhất; xem phần cost optimization trong submission/REPORT.md.
MAX_OUTPUT_TOKENS=200
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROMPT_NAME=day13-chat
LANGFUSE_PROMPT_LABEL=production
